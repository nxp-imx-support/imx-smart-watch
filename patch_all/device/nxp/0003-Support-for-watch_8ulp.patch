From e770d0e3605d306412022464818ad4235dd94e82 Mon Sep 17 00:00:00 2001
From: Jason He <jason.he_1@nxp.com>
Date: Fri, 31 Oct 2025 12:14:46 +0900
Subject: [PATCH 3/3] Support for watch_8ulp

1. m33 image is get from SDK instead of prebuilt bin.

Change-Id: I597ecc463bff641c33c6db325b3fc3f2a80821e7
Signed-off-by: Jason He <jason.he_1@nxp.com>
---
 imx8ulp/watch_8ulp/AndroidUboot.sh | 35 ++++++++++++++++++++++++++++--
 1 file changed, 33 insertions(+), 2 deletions(-)

diff --git a/imx8ulp/watch_8ulp/AndroidUboot.sh b/imx8ulp/watch_8ulp/AndroidUboot.sh
index 3510a9838..8c8555c33 100644
--- a/imx8ulp/watch_8ulp/AndroidUboot.sh
+++ b/imx8ulp/watch_8ulp/AndroidUboot.sh
@@ -30,15 +30,46 @@ fi
 MKIMAGE_SOC=iMX8ULP
 BOARD_MKIMAGE_PATH=${IMX_MKIMAGE_PATH}/imx-mkimage/${MKIMAGE_SOC}
 
+MCU_SDK_IMX8ULP_DEMO_PATH=${IMX_MCU_SDK_PATH}/mcu-sdk/imx8ulp_watch/boards/evkmimx8ulp/demo_apps/power_mode_switch/armgcc
+MCU_SDK_IMX8ULP_CMAKE_FILE=../../../../../tools/cmake_toolchain_files/armgcc.cmake
+
+UBOOT_MCU_OUT=${TARGET_OUT_INTERMEDIATES}/MCU_OBJ
+UBOOT_MCU_BUILD_TYPE=release
+
+build_mcu_image_core()
+{
+	mkdir -p ${UBOOT_MCU_OUT}/$2
+	/usr/bin/cmake -DCMAKE_TOOLCHAIN_FILE="$4" -G "Unix Makefiles" -DCMAKE_BUILD_TYPE=$3 -S $1 -B ${UBOOT_MCU_OUT}/$2 1>/dev/null
+	make -C ${UBOOT_MCU_OUT}/$2 1>/dev/null
+}
+
+
+if [ "${ARMGCC_DIR}" = "" ]; then
+	echo ERROR: \*\*\* please install arm-none-eabi-gcc toolchain and set the installed path to ARMGCC_DIR
+	exit 1
+fi
+
 build_m4_image()
 {
-	:
+	rm -rf ${UBOOT_MCU_OUT}
+	mkdir -p ${UBOOT_MCU_OUT}
+
+	cmake_version=$(/usr/bin/cmake --version | head -n 1 | tr " " "\n" | tail -n 1)
+	req_version="3.13.0"
+	if [ "`echo "$cmake_version $req_version" | tr " " "\n" | sort -V | head -n 1`" != "$req_version" ]; then
+		echo ERROR: \*\*\* please upgrade cmake version to $req_version or newer
+		exit 1
+	fi
+
+	build_mcu_image_core ${MCU_SDK_IMX8ULP_DEMO_PATH} MIMX8ULP ${UBOOT_MCU_BUILD_TYPE} ${MCU_SDK_IMX8ULP_CMAKE_FILE}
+	cp ${MCU_SDK_IMX8ULP_DEMO_PATH}/${UBOOT_MCU_BUILD_TYPE}/*.bin ${PRODUCT_OUT}/imx8ulp_watch_mcu_demo.bin
 }
 
 build_imx_uboot()
 {
 	echo Building i.MX U-Boot with firmware
-	cp ${FSL_PROPRIETARY_PATH}/fsl-proprietary/mcu-sdk/imx8ulp/imx8ulp_watch_mcu_demo.img ${BOARD_MKIMAGE_PATH}/m33_image.bin
+	cp ${MCU_SDK_IMX8ULP_DEMO_PATH}/${UBOOT_MCU_BUILD_TYPE}/*.bin ${BOARD_MKIMAGE_PATH}/m33_image.bin
+	# cp ${FSL_PROPRIETARY_PATH}/fsl-proprietary/mcu-sdk/imx8ulp/imx8ulp_watch_mcu_demo.img ${BOARD_MKIMAGE_PATH}/m33_image.bin
 	cp ${FSL_PROPRIETARY_PATH}/fsl-proprietary/uboot-firmware/imx8ulp/upower.bin ${BOARD_MKIMAGE_PATH}/upower.bin
 	cp ${FSL_PROPRIETARY_PATH}/ele/mx8ulpa2-ahab-container.img ${BOARD_MKIMAGE_PATH}
 	cp ${UBOOT_OUT}/u-boot.$1 ${BOARD_MKIMAGE_PATH}
-- 
