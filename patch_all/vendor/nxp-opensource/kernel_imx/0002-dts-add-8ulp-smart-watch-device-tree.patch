From df738c6677d855e55ea559f5ed8daaed04bce2fd Mon Sep 17 00:00:00 2001
From: Xinyu Chen <xinyu.chen@nxp.com>
Date: Mon, 9 Jan 2023 17:00:00 +0800
Subject: [PATCH 02/10] dts: add 8ulp smart watch device tree.

Signed-off-by: Xinyu Chen <xinyu.chen@nxp.com>
Signed-off-by: Terry Lv <Terry.Lv@nxp.com>
---
 arch/arm64/boot/dts/freescale/Makefile         |  3 ++-
 .../arm64/boot/dts/freescale/imx8ulp-watch.dts | 18 ++++++++++++++++++
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/freescale/Makefile b/arch/arm64/boot/dts/freescale/Makefile
index 905026666bc7..325c490e0003 100644
--- a/arch/arm64/boot/dts/freescale/Makefile
+++ b/arch/arm64/boot/dts/freescale/Makefile
@@ -232,7 +232,8 @@ dtb-$(CONFIG_ARCH_MXC) += imx8ulp-evk.dtb imx8ulp-evk-lpspi-slave.dtb \
 			  imx8ulp-9x9-evk-rk055hdmipi4m.dtb imx8ulp-9x9-evk-rk055hdmipi4mv2.dtb \
 			  imx8ulp-9x9-evk-lpspi.dtb imx8ulp-9x9-evk-lpspi-slave.dtb \
 			  imx8ulp-9x9-evk-i3c.dtb imx8ulp-9x9-evk-sof-btsco.dtb \
-			  imx8ulp-evk-lpa.dtb imx8ulp-9x9-evk-lpa.dtb
+			  imx8ulp-evk-lpa.dtb imx8ulp-9x9-evk-lpa.dtb \
+			  imx8ulp-watch.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8qm-mek.dtb imx8qm-mek-ov5640.dtb \
 			  imx8qm-mek-enet2-tja1100.dtb imx8qm-mek-rpmsg.dtb \
 			  imx8qm-mek-hdmi.dtb \
diff --git a/arch/arm64/boot/dts/freescale/imx8ulp-watch.dts b/arch/arm64/boot/dts/freescale/imx8ulp-watch.dts
index 1849e53b5b93..c55afeb9eeff 100644
--- a/arch/arm64/boot/dts/freescale/imx8ulp-watch.dts
+++ b/arch/arm64/boot/dts/freescale/imx8ulp-watch.dts
@@ -127,6 +127,14 @@ m33_reserved: m33_noncacheable_section@a8600000 {
 		};
 	};
 
+	clock_ext_ts: clock-ext-ts {
+		compatible = "fixed-clock";
+		/* External ts clock is 50MHZ from PHY on EVK board. */
+		clock-frequency = <50000000>;
+		clock-output-names = "ext_ts_clk";
+		#clock-cells = <0>;
+	};
+
 	reg_5v: regulator-5v {
 		compatible = "regulator-fixed";
 		regulator-name = "5V";
@@ -269,6 +277,14 @@ lsm6dsm@6a {
 		reg = <0x6a>;
 	};
 
+	tsl2540@39 {
+		compatible = "ams,tsl2540";
+		reg = <0x39>;
+		interrupt-parent = <&rpmsg_gpioa>;
+		interrupts = <24 IRQ_TYPE_EDGE_FALLING>;
+	};
+
+	/*
 	heart-rate@57 {
 		compatible = "maxim,max30105";// max30101 is almost the same as max30105
 		reg = <0x57>;
@@ -278,6 +294,7 @@ heart-rate@57 {
 		interrupt-parent = <&rpmsg_gpiob>;
 		interrupts = <12 IRQ_TYPE_EDGE_FALLING>;
 	};
+	*/
 
 	bat: fuel-gauge@36 {
 		compatible = "maxim,max17055";
@@ -364,6 +381,7 @@ &usbotg1 {
 
 &usbphy1 {
 	status = "okay";
+	fsl,tx-d-cal = <110>;
 };
 
 &usbmisc1 {
-- 
2.25.1

