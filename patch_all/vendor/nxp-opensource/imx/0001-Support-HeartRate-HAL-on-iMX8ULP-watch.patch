diff --git a/iio_sensor/HeartRateSensor.cpp b/iio_sensor/HeartRateSensor.cpp
new file mode 100644
index 0000000..b1a3c85
--- /dev/null
+++ b/iio_sensor/HeartRateSensor.cpp
@@ -0,0 +1,111 @@
