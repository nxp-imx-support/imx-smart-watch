 namespace nxp_sensors_subhal {
 
@@ -109,6 +112,10 @@ static int sysfs_opendir(const std::string& name, DirPtr* dp) {
 // from the type of value being passed in? that would be a safer alternative
 template <typename T>
 static int sysfs_write_val(const std::string& f, const std::string& fmt, const T value) {
+    std::string str = "sysfs_write_val %s ";
+    str += fmt;
+    str += "\n";
+    ALOGE(str.c_str(), f.c_str(), value);
     FilePtr fp = {fopen(f.c_str(), "r+"), fclose};
     if (nullptr == fp)
         return -errno;
@@ -204,6 +211,22 @@ int enable_step_sensor(const std::string& device_dir, const bool enable) {
         enable_file += "/";
         enable_file += IIO_STEP_BUFFER_ENABLE;
         err = sysfs_write_uint(enable_file, enable);
+
+        enable_file = device_dir;
+        enable_file += "/";
+        enable_file += IIO_ACTIVITY_BUFFER_ENABLE;
+        err = sysfs_write_uint(enable_file, enable);
+    }
+    return err;
+}
+
+int enable_heartrate_sensor(const std::string& device_dir, const bool enable) {
+    int err = check_file(device_dir);
+    if (!err) {
+        std::string enable_file = device_dir;
+        enable_file += "/";
+        enable_file += IIO_HEARTRATE_BUFFER_ENABLE;
+        err = sysfs_write_uint(enable_file, enable);
     }
     return err;
 }
@@ -410,6 +433,12 @@ int get_sensor_stepcounter(const std::string& device_dir, unsigned int* stepcoun
     return sysfs_read_uint(filename, stepcounter);
 }
 
+int get_sensor_heartratecounter(const std::string& device_dir, unsigned int* heartratecounter) {
+    const std::string filename = device_dir + "/" + IIO_HEARTRATECOUNTER_INPUT;
+
+    return sysfs_read_uint(filename, heartratecounter);
+}
