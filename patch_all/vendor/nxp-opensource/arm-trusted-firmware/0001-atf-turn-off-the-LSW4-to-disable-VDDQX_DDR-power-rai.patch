From 5e51b9fe5ba81e0be6a3bae9e680aa8cf4e558e6 Mon Sep 17 00:00:00 2001
From: Xinyu Chen <xinyu.chen@nxp.com>
Date: Fri, 9 Jun 2023 10:26:44 +0800
Subject: [PATCH 1/3] atf: turn off the LSW4 to disable VDDQX_DDR power rail
 during PD.

Signed-off-by: Xinyu Chen <xinyu.chen@nxp.com>
---
 plat/imx/imx8ulp/imx8ulp_psci.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/plat/imx/imx8ulp/imx8ulp_psci.c b/plat/imx/imx8ulp/imx8ulp_psci.c
index 448748cae..e69d1da48 100644
--- a/plat/imx/imx8ulp/imx8ulp_psci.c
+++ b/plat/imx/imx8ulp/imx8ulp_psci.c
@@ -221,18 +221,32 @@ ps_apd_pmic_reg_data_cfgs_t pd_pmic_reg_cfgs = {
 		.i2c_addr = 0x22,
 		.i2c_data = 0xb,
 	},
+	/* Power Down: off LSW4 */
 	[2] = {
+		.tag = PMIC_REG_VALID_TAG,
+		.power_mode = PD_PWR_MODE,
+		.i2c_addr = 0x43, /* LSW4_CTRL of PCA9460 */
+		.i2c_data = 0x0,  /* LSW4_EN[1:0] = 00b(OFF) */
+	},
+	[3] = {
 		.tag = PMIC_REG_VALID_TAG,
 		.power_mode = ACT_PWR_MODE,
 		.i2c_addr = 0x30,
 		.i2c_data = 0x9d,
 	},
-	[3] = {
+	[4] = {
 		.tag = PMIC_REG_VALID_TAG,
 		.power_mode = ACT_PWR_MODE,
 		.i2c_addr = 0x22,
 		.i2c_data = 0x28,
 	},
+	/* Active: on LSW4 */
+	[5] = {
+		.tag = PMIC_REG_VALID_TAG,
+		.power_mode = ACT_PWR_MODE,
+		.i2c_addr = 0x43, /* LSW4_CTRL of PCA9460 */
+		.i2c_data = 0x11, /* LSW4_EN[1:0] = 01b(ON at RUN state) */
+	},
 };
 
 /* PMIC config for deep power down, BUCK3 should be OFF */
-- 
