From 9add0547b69ddf3fab459699552f3f29553da1c7 Mon Sep 17 00:00:00 2001
From: Jason He <jason.he_1@nxp.com>
Date: Tue, 12 Nov 2024 18:35:26 +0900
Subject: [PATCH] Make JCOP into DPD and save power.

Change-Id: I3b112f305a97823ddf4083575659ef42dc392139
Signed-off-by: Jason He <jason.he_1@nxp.com>
---
 snxxx/halimpl/hal/phNxpNciHal.cc | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/snxxx/halimpl/hal/phNxpNciHal.cc b/snxxx/halimpl/hal/phNxpNciHal.cc
index 454cb31..f2e235a 100644
--- a/snxxx/halimpl/hal/phNxpNciHal.cc
+++ b/snxxx/halimpl/hal/phNxpNciHal.cc
@@ -1481,11 +1481,14 @@ int phNxpNciHal_core_initialized(uint16_t core_init_rsp_params_len,
 
   uint8_t swp_full_pwr_mode_on_cmd[] = {0x20, 0x02, 0x05, 0x01,
                                         0xA0, 0xF1, 0x01, 0x01};
+  //uint8_t enable_ce_in_phone_off = 0x00;
   uint8_t enable_ce_in_phone_off = 0x01;
   uint8_t enable_ven_cfg = 0x01;
 
   uint8_t swp_switch_timeout_cmd[] = {0x20, 0x02, 0x06, 0x01, 0xA0,
                                       0xF3, 0x02, 0x00, 0x00};
+  uint8_t cmd_setA19A[] = {0x20, 0x02, 0x05, 0x01, 0xA1, 0x9A, 0x01, 0x01};
+  //uint8_t cmd_getA19A[] = {0x20, 0x03, 0x03, 0x01, 0xA1, 0x9A};
 
   config_success = true;
   long bufflen = 260;
@@ -1639,6 +1642,20 @@ int phNxpNciHal_core_initialized(uint16_t core_init_rsp_params_len,
     request_EEPROM(&mEEPROM_info);
   }
 
+#if 0
+  status = phNxpNciHal_send_ext_cmd(sizeof(cmd_getA19A), cmd_getA19A);
+  if (status != NFCSTATUS_SUCCESS) {
+    NXPLOG_NCIHAL_E("CMD_GET_A19A: Failed");
+  }
+#endif
+
+#if 1
+  status = phNxpNciHal_send_ext_cmd(sizeof(cmd_setA19A), cmd_setA19A);
+  if (status != NFCSTATUS_SUCCESS) {
+    NXPLOG_NCIHAL_E("CMD_SET_A19A: Failed");
+  }
+#endif
+
   phNxpNciHal_propConfULPDetMode(false);
 
   if (gPowerTrackerHandle.start != NULL) {
-- 
